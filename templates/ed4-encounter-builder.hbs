<div class="ed4-encounter-builder-container" style="display: flex; flex-direction: column; height: 100%; gap: 8px;">

  <!-- PERSISTENT HEADER (Editable Title, Description & Gauge) -->
  <header style="display: flex; gap: 12px; background: rgba(0,0,0,0.2); padding: 8px; border-radius: 4px; border: 1px solid var(--color-border-dark);">
    <div style="flex: 2; display: flex; flex-direction: column; gap: 4px;">
      <input type="text" name="label" value="{{encounter.label}}" placeholder="Encounter Name" style="font-size: 1.4em; font-weight: bold; border: none; background: transparent; margin: 0; padding: 2px 0; width: 100%; box-sizing: border-box;" />
      <textarea rows="2" name="description" placeholder="{{ localize 'ED4-ENCOUNTERBUILDER.builder-form.description-inputhint' }}" style="width: 100%; box-sizing: border-box; resize: none;">{{encounter.description}}</textarea>
    </div>
    
    <div style="flex: 0 0 160px; text-align: center;">
      <h4 style="margin: 0;">{{ localize "ED4-ENCOUNTERBUILDER.builder-form.encounter-difficulty" }}: {{encounter.difficultyRating}}</h4>
      <img src="modules/ed4-encounter-builder/assets/difficulty-gauge-{{encounter.difficultyRating}}.png" alt="{{encounter.difficultyRating}} difficulty indicator" style="width: 100%; height: auto; border: none;"/>
    </div>
  </header>

  <!-- TAB NAVIGATION -->
  <nav class="sheet-tabs tabs" data-group="primary" style="display: flex; border-bottom: 1px solid var(--color-border-dark);">
    <a class="item active" data-tab="roster"><i class="fas fa-users-slash"></i> {{ localize "ED4-ENCOUNTERBUILDER.builder-form.encounter-challenge-section" }} & {{ localize "ED4-ENCOUNTERBUILDER.builder-form.enemies-label" }}</a>
    <a class="item" data-tab="notes"><i class="fas fa-book-open"></i> {{ localize "ED4-ENCOUNTERBUILDER.builder-form.encounter-details-section" }}</a>
  </nav>

  <!-- TAB CONTENT AREA -->
  <section class="tab-content" style="flex: 1; overflow: hidden;">
    
    <!-- TAB 1: ROSTER & MONSTERS -->
    <div class="tab active" data-tab="roster" data-group="primary" style="display: block; height: 100%;">
      <div style="display: grid; grid-template-columns: 1fr 1.2fr; gap: 10px; height: 100%;">
        
        <!-- Left Column: Party & Active Enemies -->
        <div style="display: flex; flex-direction: column; gap: 10px; height: 100%; min-height: 0;">
          <fieldset style="flex: 1; display: flex; flex-direction: column; min-height: 0; overflow: hidden;">
            <legend>{{localize "ED4-ENCOUNTERBUILDER.builder-form.pcs-label"}} ({{allpcs.length}} {{localize "ED4-ENCOUNTERBUILDER.builder-form.available-label"}})</legend>
            <!-- Removed max-height, added flex: 1 -->
            <ul class="nav-ul" style="flex: 1; overflow-y: auto; margin: 0; padding: 0;">
              {{#each allpcs}}
              <li class="flexrow" data-encounter-pc-id="{{id}}" style="align-items: center; gap: 6px; padding: 2px 0;">
                <input class="flex0" type="checkbox" name="pc.{{id}}" data-action="toggle-pc" title="{{localize 'ED4-ENCOUNTERBUILDER.builder-form.mark-done'}}" {{#if (pcIsInEncounter id ../encounter.id)}}checked{{/if}}/>
                <img class="flex0" src="{{img}}" width="24" height="24" alt="{{name}}"/>
                <span class="flex" style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">{{name}}</span>
                <span class="flex0" style="font-weight: bold; width: 65px; text-align: right; white-space: nowrap;">EC {{flags.ed4-encounter-builder.effectiveCircle}}</span>
              </li>
              {{/each}}
            </ul>
          </fieldset>

          <fieldset style="flex: 1; display: flex; flex-direction: column; min-height: 0; overflow: hidden;">
            <legend>{{localize "ED4-ENCOUNTERBUILDER.builder-form.enemies-label"}}</legend>
            <ul class="nav-ul" style="flex: 1; overflow-y: auto; margin: 0; padding: 0;">
              {{#each encounter.enemies}}
              <li class="flexrow" data-encounter-adversary-id="{{id}}" style="align-items: center; gap: 6px; padding: 2px 0;">
                <input class="flex0" type="number" value="{{count}}" name="enemyCount.{{id}}" min="1" style="width: 45px;"/>
                <img class="flex0" src="{{img}}" width="24" height="24" alt="{{name}}"/>
                <span class="flex" style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">{{name}}</span>
                <button type="button" title="{{localize 'ED4-ENCOUNTERBUILDER.builder-form.view-adversary-hint'}}" data-action="view-adversary" class="flex0 icon-button">
                  <i class="fas fa-eye"></i>
                </button>
                <span class="flex0" style="width: 60px; text-align: center; white-space: nowrap;">CR {{challenge}}</span>
                <button type="button" title="{{localize 'ED4-ENCOUNTERBUILDER.builder-form.build-encounter'}}" data-action="remove" class="flex0 icon-button">
                  <i class="fas fa-trash"></i>
                </button>
              </li>
              {{/each}}
            </ul>
          </fieldset>
        </div>

        <!-- Right Column: Monster Search -->
        <fieldset style="display: flex; flex-direction: column; height: 100%; min-height: 0; overflow: hidden;">
          <legend>{{localize "ED4-ENCOUNTERBUILDER.builder-form.add-more-label"}}</legend>
          <div class="flexrow" style="gap: 4px; margin-bottom: 6px; flex: 0 0 auto;">
            <input type="text" value="{{filter}}" name="filter" placeholder="{{ localize 'ED4-ENCOUNTERBUILDER.builder-form.search-inputhint' }}" class="flex2"/>
            <input type="text" value="{{crfilter}}" name="crfilter" placeholder="{{ localize 'ED4-ENCOUNTERBUILDER.builder-form.crfilter-inputhint' }}" class="flex1"/>
            <input type="text" value="{{crmaxfilter}}" name="crmaxfilter" placeholder="{{ localize 'ED4-ENCOUNTERBUILDER.builder-form.crfiltermax-inputhint' }}" class="flex1"/>
          </div>
          <ul class="nav-ul" style="flex: 1; overflow-y: auto; margin: 0; padding: 0;">
            {{#each adversaries}}
            <li class="flexrow" data-encounter-adversary-id="{{id}}" style="align-items: center; gap: 6px; padding: 2px 0;">
              <input class="flex0" type="number" value="1" min="1" name="addCount.{{id}}" style="width: 40px;"/>
              <button type="button" title="{{localize 'ED4-ENCOUNTERBUILDER.builder-form.build-encounter'}}" data-action="add" class="flex0">
                <i class="fas fa-plus"></i>
              </button>
              <img class="flex0" src="{{img}}" width="24" height="24" alt="{{name}}"/>
              <span class="flex" style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">{{name}}</span>
              <button type="button" title="{{localize 'ED4-ENCOUNTERBUILDER.builder-form.view-adversary'}}" data-action="view-adversary" class="flex0 icon-button">
                <i class="fas fa-eye"></i>
              </button>
              <span class="flex0" style="width: 60px; text-align: right; white-space: nowrap; font-size: 0.85em; opacity: 0.8;">CR {{challenge}}</span>
            </li>
            {{/each}}
          </ul>
        </fieldset>

      </div>
    </div>

    <!-- TAB 2: GM NOTES -->
    <div class="tab" data-tab="notes" data-group="primary" style="display: none; height: 100%;">
      <div style="display: flex; flex-direction: column; gap: 10px; height: 100%;">
        <fieldset style="flex: 1; display: flex; flex-direction: column;">
          <legend>{{ localize "ED4-ENCOUNTERBUILDER.builder-form.environment-label" }}</legend>
          <textarea name="environment" placeholder="{{ localize 'ED4-ENCOUNTERBUILDER.builder-form.environment-inputhint' }}" style="width:100%; flex: 1; box-sizing: border-box; resize: none;">{{encounter.environment}}</textarea>
        </fieldset>

        <fieldset style="flex: 1; display: flex; flex-direction: column;">
          <legend>{{ localize "ED4-ENCOUNTERBUILDER.builder-form.tactics-label" }}</legend>
          <textarea name="tactics" placeholder="{{ localize 'ED4-ENCOUNTERBUILDER.builder-form.tactics-inputhint' }}" style="width:100%; flex: 1; box-sizing: border-box; resize: none;">{{encounter.tactics}}</textarea>
        </fieldset>

        <fieldset style="flex: 1; display: flex; flex-direction: column;">
          <legend style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
            <span>{{ localize "ED4-ENCOUNTERBUILDER.builder-form.rewards-label" }}</span>
            <button type="button" data-action="generateReward" style="width: auto; padding: 2px 8px; font-size: 0.8em; margin-left: auto;">
              <i class="fas fa-coins"></i> {{ localize "ED4-ENCOUNTERBUILDER.builder-form.ecr-award-button" }}
            </button>
          </legend>
          <textarea name="rewards" placeholder="{{ localize 'ED4-ENCOUNTERBUILDER.builder-form.rewards-inputhint' }}" style="width:100%; flex: 1; box-sizing: border-box; resize: none;">{{encounter.rewards}}</textarea>
        </fieldset>
      </div>
    </div>

  </section>

  <footer style="flex: 0 0 auto;">
    <div class="flexrow" style="gap: 6px; width: 100%;">
      <!-- Done Button -->
      <button type="button" data-action="done" class="flex1">
        {{localize "ED4-ENCOUNTERBUILDER.builder-form.done-button-text"}}
      </button>
      
      <!-- Send to Combat Button -->
      <button type="button" data-action="send-to-combat" class="flex1" title="{{localize 'ED4-ENCOUNTERBUILDER.builder-form.send-to-combat'}}">
        <i class="fas fa-fist-raised"></i> {{localize "ED4-ENCOUNTERBUILDER.builder-form.send-to-combat"}}
      </button>
    </div>
  </footer>

</div>